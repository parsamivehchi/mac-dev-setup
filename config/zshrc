# ====================
# Basic Shell Settings
# ====================
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# ====================
# Path Configuration
# ====================
# Homebrew paths (M1/M2 Mac)
eval "$(/opt/homebrew/bin/brew shellenv)"
export PATH="/opt/homebrew/bin:$PATH"
export PATH="/opt/homebrew/sbin:$PATH"
export PATH="$HOME/bin:$PATH"

# ====================
# Python Configuration
# ====================
# Set Python 3.13 as default
export PATH="/opt/homebrew/opt/python@3.13/bin:$PATH"

# Python aliases
alias python=python3.13
alias pip=pip3.13

# ====================
# Editor Configuration
# ====================
export EDITOR='code'
export VISUAL='code'

# ====================
# API Tokens (stored in macOS Keychain)
# ====================
# To add a token:  security add-generic-password -a "$USER" -s "TOKEN_NAME" -w "value" -U
# To read a token: security find-generic-password -a "$USER" -s "TOKEN_NAME" -w
export VERCEL_TOKEN=$(security find-generic-password -a "$USER" -s "VERCEL_TOKEN" -w 2>/dev/null)

# ====================
# Machine-Specific Overrides
# ====================
# Source local secrets/config not tracked in git
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# ====================
# History Configuration
# ====================
HISTSIZE=10000
SAVEHIST=10000
HISTFILE=~/.zsh_history
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS

# ====================
# Custom Aliases
# ====================
# Navigation
alias ll='ls -la'
alias la='ls -A'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'
alias c='clear'

# Git shortcuts
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git pull'

# Custom scripts — add your own here
# alias update-dev='$HOME/bin/update-dev'

# ====================
# Functions
# ====================
# Wrap claude to auto-set terminal title to working directory
claude() {
  local dir="${PWD/#$HOME/\~}"
  command claude --name "$dir" "$@"
}

# Function to update all package managers
update_all() {
    echo "🚀 Starting system update..."

    echo "\n📦 Updating Homebrew..."
    brew update && brew upgrade && brew cleanup

    echo "\n🔧 Updating pipx applications..."
    pipx upgrade-all

    echo "\n✨ Update complete!"
}

# Function to create a new directory and cd into it
mkcd() {
    mkdir -p "$1" && cd "$1"
}

# Function to create and manage virtual environments
mkvenv() {
    python3.13 -m venv "$HOME/.virtualenvs/$1"
    source "$HOME/.virtualenvs/$1/bin/activate"
}

workon() {
    if [ -z "$1" ]; then
        ls "$HOME/.virtualenvs"
    else
        source "$HOME/.virtualenvs/$1/bin/activate"
    fi
}

# ====================
# Prompt Customization
# ====================
# Load version control info
autoload -Uz vcs_info
precmd() { vcs_info }

# Format the vcs_info_msg_0_ variable
zstyle ':vcs_info:git:*' formats '(%b)'

# Set up the prompt with virtual environment info
setopt PROMPT_SUBST
PROMPT='%F{green}%n@%m%f %F{blue}%~%f %F{yellow}${vcs_info_msg_0_}%f $ '

# ====================
# Ghostty Tab Title
# ====================
# Set tab title to current working directory on every cd
chpwd() {
  echo -ne "\e]0;${PWD}\a"
}
chpwd

# ====================
# Auto-completion
# ====================
autoload -Uz compinit
