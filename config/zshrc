# ============================================
# Ghostty Per-Pane Color Hook
# ============================================
# Assigns each pane a unique background color based on its TTY number.
# Only runs inside Ghostty. Fires once on shell startup.

_ghostty_pane_color() {
  [[ -z "$GHOSTTY_RESOURCES_DIR" ]] && return

  local my_tty
  my_tty=$(tty 2>/dev/null)
  [[ "$my_tty" == "not a tty" || -z "$my_tty" ]] && return

  # Extract numeric suffix from TTY path (e.g. /dev/ttys003 -> 3)
  local tty_num="${my_tty##*s}"
  tty_num=$((10#$tty_num))  # force base-10

  # 8 bold neon background colors
  local -a colors=(
    '#0d2040'  # cobalt
    '#0d3820'  # emerald
    '#380d28'  # magenta
    '#38280d'  # gold
    '#280d40'  # purple
    '#0d3838'  # teal
    '#381a0d'  # rust
    '#1a380d'  # grass
  )

  local idx=$(( tty_num % ${#colors[@]} ))
  printf '\e]11;%s\a' "${colors[$((idx + 1))]}"
}

# Fire on shell startup (so each new pane gets its color)
_ghostty_pane_color

# ===== Claude Code aliases =====
# Note: `cc` shadows /usr/bin/cc (C compiler) in interactive zsh sessions only.
# Scripts, Makefiles, and builds run via /bin/sh and are unaffected.
# Use /usr/bin/cc directly if you ever need to compile C manually.

alias cc='claude'                                 # Claude Code (Anthropic API, normal mode)
alias cc-skip='claude --dangerously-skip-permissions'   # Claude Code, YOLO mode

# --- Local Claude Code via Ollama ---
# For low-stakes local work to avoid burning API credits.
# Only one model loads at a time; switching takes 10-30s.
# (Ollama env vars set in the Ollama Configuration block above.)

# Local aliases use --bare: skips CLAUDE.md auto-discovery, hooks, plugins, LSP, MCP,
# auto-memory. Cuts baseline prefill from ~30k to ~2-3k tokens per turn — essential
# for local models on 32GB RAM. Tradeoff: no project context auto-loading.
alias cc-local='ollama launch claude -y --model qwen3-coder -- --dangerously-skip-permissions --bare'        # DAILY DRIVER
alias cc-local-heavy='ollama launch claude -y --model gemma4:26b -- --dangerously-skip-permissions --bare'   # highest quality
alias cc-local-tiny='ollama launch claude -y --model gemma4:e4b -- --dangerously-skip-permissions --bare'    # smallest tool-capable
alias cc-local-coder='ollama launch claude -y --model qwen2.5-coder:14b -- --dangerously-skip-permissions --bare' # code specialist

# Non-bare local aliases — full CLAUDE.md/hooks/plugins loaded. SLOW on 32GB.
alias cc-local-full='ollama launch claude -y --model qwen3-coder -- --dangerously-skip-permissions'
alias cc-local-heavy-full='ollama launch claude -y --model gemma4:26b -- --dangerously-skip-permissions'

# Quick reference: print all cc* commands with their purpose
cc-help() {
  local bold=$(tput bold) dim=$(tput dim) cyan=$(tput setaf 6) yellow=$(tput setaf 3) green=$(tput setaf 2) reset=$(tput sgr0)
  cat <<EOF

  ${bold}Claude Code aliases${reset}  ${dim}— remote (Anthropic) and local (Ollama)${reset}

  ${yellow}Remote${reset} ${dim}(Anthropic API — use for file ops, counting, agentic work)${reset}
    ${cyan}cc${reset}               Claude Code, normal mode
    ${cyan}cc-skip${reset}          Claude Code, YOLO mode (skip permissions)

  ${yellow}Local — bare mode${reset} ${dim}(--bare: no CLAUDE.md/hooks/plugins, 10x faster on 32GB)${reset}
    ${green}cc-local${reset}         qwen3-coder        ${dim}DAILY DRIVER — strong tool use${reset}
    ${green}cc-local-heavy${reset}   gemma4:26b         ${dim}highest quality, slow TTFT${reset}
    ${green}cc-local-tiny${reset}    gemma4:e4b         ${dim}smallest tool-capable, multimodal${reset}
    ${green}cc-local-coder${reset}   qwen2.5-coder:14b  ${dim}dense code specialist fallback${reset}

  ${yellow}Local — full mode${reset} ${dim}(loads CLAUDE.md/plugins — SLOW on 32GB, 30-60s per turn)${reset}
    ${green}cc-local-full${reset}         qwen3-coder  ${dim}only if you need project context${reset}
    ${green}cc-local-heavy-full${reset}   gemma4:26b   ${dim}only if you need quality + context${reset}

  ${yellow}Utilities${reset}
    ${cyan}cc-help${reset}          Show this menu
    ${cyan}ollama ps${reset}        See which model is currently loaded in RAM
    ${cyan}sudo mactop${reset}      Live CPU/GPU/ANE monitor (watch GPU spike during inference)

  ${dim}Warning: Local models hallucinate on large tool outputs (e.g. "count 6000 files").
     Use ${reset}${cyan}cc${reset}${dim} for anything where the right answer depends on reading a big list.${reset}

EOF
}

